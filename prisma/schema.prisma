generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SemaCoreIdentityState {
  stateKey       String   @id
  installationId String   @unique
  nextLocalId    BigInt   @default(1)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sema_core_identity_state")
}

model SemaIdentifierReservation {
  id              String   @id
  installationId  String
  firstLocalValue BigInt
  count           Int
  typeCode        String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([installationId, firstLocalValue])
  @@map("sema_identifier_reservations")
}

model SemaIssuedIdentifier {
  semaId          String   @id
  reservationId   String
  installationId  String
  localValue      BigInt
  localCode       String
  typeCode        String?
  status          String   @default("RESERVED")
  metadata        Json     @default("{}")
  issuedAt        DateTime @default(now())
  consumedAt      DateTime?

  @@unique([installationId, localValue])
  @@index([reservationId, status])
  @@index([typeCode])
  @@map("sema_issued_identifiers")
}

model SemaCoreCommand {
  id         String   @id
  commandType String
  actorId    String?
  workspaceId String?
  subjectIds Json     @default("[]")
  context    Json     @default("{}")
  payload    Json     @default("{}")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([commandType, createdAt])
  @@index([actorId, createdAt])
  @@map("sema_core_commands")
}

model SemaCoreExecution {
  id          String   @id
  commandId   String
  providerId  String?
  status      String   @default("PENDING")
  startedAt   DateTime?
  completedAt DateTime?
  context     Json     @default("{}")
  error       Json?
  createdAt   DateTime @default(now())

  @@index([commandId, createdAt])
  @@index([status, createdAt])
  @@map("sema_core_executions")
}

model SemaCoreResult {
  id          String   @id
  executionId String
  resultType  String
  subjectIds  Json     @default("[]")
  data        Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([executionId, createdAt])
  @@map("sema_core_results")
}

model SemaCoreEvent {
  id          String   @id
  eventType   String
  commandId   String?
  executionId String?
  subjectIds  Json     @default("[]")
  data        Json     @default("{}")
  occurredAt  DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([commandId, occurredAt])
  @@map("sema_core_events")
}

model SemaCoreAuditEntry {
  id          String   @id
  action      String
  actorId     String?
  commandId   String?
  executionId String?
  subjectIds  Json     @default("[]")
  evidence    Json     @default("{}")
  occurredAt  DateTime @default(now())

  @@index([action, occurredAt])
  @@index([actorId, occurredAt])
  @@map("sema_core_audit_entries")
}

model SemaCoreCapability {
  id            String   @id
  capabilityKey String   @unique
  displayName   String
  description   String
  providerKey   String
  version       String
  status        String   @default("ACTIVE")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, displayName])
  @@map("sema_core_capabilities")
}

model SemaCoreHostSettings {
  installationId String   @id
  revision       Int
  updatedAt      DateTime
  updatedById    String?
  values         Json     @default("{}")

  @@map("sema_core_host_settings")
}

/// The block of first IDs this Core may assign to new systems. One row. `issued` is the last value given out;
/// `blockEnd` is the first value beyond the block.
model SemaTopLevelCounter {
  counterKey String   @id
  block      Int
  issued     BigInt
  blockEnd   BigInt
  updatedAt  DateTime @updatedAt

  @@map("sema_top_level_counter")
}

model SemaLocalNode {
  id         String   @id
  type       String
  parentId   String?
  parentAddress String?
  basis      String
  issued     BigInt   @default(0)
  childListComplete Boolean @default(true)
  /// Optional key limits, set only on an organization node. Null means no limit.
  maxSegments          Int?
  maxSegmentLength     Int?
  maxLastSegmentLength Int?
  /// A basis fetched early, ready to take over when the counter would pass switchAt. Both set, or neither.
  nextBasis            String?
  switchAt             BigInt?
  /// Set when the node is shut down: the node that was suspended (this one or an ancestor), why, by whom, when, and
  /// how this node learned it (ORDER or PARENT). All set, or none. Times are UTC.
  shutdownNodeId       String?
  shutdownReason       String?
  shutdownBy           String?
  shutdownAt           DateTime?
  shutdownVia          String?
  /// Seats, used only on an organization node: users and machines in use (taken when added, given back when
  /// removed; may be too high, never too low) and allowed (empty: no limit).
  usersUsed            Int      @default(0)
  machinesUsed         Int      @default(0)
  usersAllowed         Int?
  machinesAllowed      Int?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([parentId])
  @@map("sema_local_nodes")
}

/// A public key a program registered with this Core, to sign its requests instead of sending its secret. Only public
/// halves are kept. A revoked key stays as a record.
model SemaCoreClientKey {
  keyId          String    @id
  applicationKey String
  publicJwk      String
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  @@index([applicationKey])
  @@map("sema_core_client_keys")
}

/// One direct child of a node held by this Core, as the parent believes it to be. The child's own pointer is the
/// truth. A list may hold too many entries, never too few.
model SemaLocalNodeChild {
  parentId     String
  childId      String
  childType    String
  childAddress String?
  addedAt      DateTime @default(now())
  lastSeenAt   DateTime?
  /// Set when the child has been suspended: the mark every other Core sees. Times are UTC.
  suspendedReason String?
  suspendedBy     String?
  suspendedAt     DateTime?
  /// Set when the child was retired while it could not be reached. The entry stays as the record that refuses it if
  /// it comes back, and is not counted as a child. Times are UTC.
  retiredReason   String?
  retiredBy       String?
  retiredAt       DateTime?

  @@id([parentId, childId])
  @@map("sema_local_node_children")
}

/// The capability and service layer (D-151). A capability version is a contract; a published one never changes.
model SemaCapabilityVersion {
  id            String   @id
  capabilityKey String
  version       String
  displayName   String
  description   String
  operations    Json     @default("[]")
  /// A name in the reserved sema. namespace that was approved (D-104).
  approved      Boolean  @default(false)
  /// Moved from the old single capability record; its contract is not written yet.
  legacy        Boolean  @default(false)
  status        String   @default("ACTIVE")
  createdAt     DateTime

  @@unique([capabilityKey, version])
  @@map("sema_core_capability_versions")
}

/// One published version of one provider's software for one capability version. Never changes.
model SemaServiceVersion {
  id                  String   @id
  serviceKey          String
  version             String
  capabilityVersionId String
  displayName         String
  operations          Json     @default("[]")
  extensions          Json     @default("[]")
  declarations        Json     @default("{}")
  legacy              Boolean  @default(false)
  status              String   @default("ACTIVE")
  createdAt           DateTime

  @@unique([serviceKey, version, capabilityVersionId])
  @@index([capabilityVersionId])
  @@map("sema_core_service_versions")
}

/// A service version installed on this machine, once. Its settings and secrets stay with the service.
model SemaServiceInstallation {
  id               String   @id
  serviceVersionId String   @unique
  machineNodeId    String
  settingsRef      String?
  endpointUrl      String?
  installedAt      DateTime

  @@map("sema_core_service_installations")
}

/// A running copy of an installed service. A stopped instance stays as a record; a new start is a new instance.
model SemaServiceInstance {
  id             String   @id
  installationId String
  startedAt      DateTime
  lastCheckInAt  DateTime
  capacity       Int      @default(1)
  resources      Json     @default("{}")
  state          String   @default("RUNNING")

  @@index([installationId])
  @@map("sema_core_service_instances")
}
